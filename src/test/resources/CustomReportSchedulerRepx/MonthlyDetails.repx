  <CalculatedFields>
    <Item1 Ref="3" Name="wo" DisplayName="WO_Day" Expression="Iif([Daily 1st Half Status] == 'WO' &amp;&amp; [Daily 2nd Half Status] == 'WO','1' ,'0')" DataMember="Monthly Details" />
    <Item2 Ref="4" Name="Wosum" DisplayName="Total WO" Expression="Sum([wo]) " DataMember="Monthly Details" />
    <Item3 Ref="5" Name="calculatedField2" DisplayName="Day Status_PH" Expression="Iif(([Daily 1st Half Status]=='PH' &amp;&amp; [Daily 2nd Half Status]=='PH'),'PH',[Daily Wrk Shift ID])" DataMember="Monthly Details" />
    <Item4 Ref="6" Name="calculatedField3" DisplayName="Day Status_WO" Expression="Iif(([Daily 1st Half Status]=='WO' &amp;&amp; [Daily 2nd Half Status]=='WO'),'WO',Iif([Daily 1st Half Status]=='PH' &amp;&amp; [Daily 2nd Half Status]=='PH','PH', [Daily Wrk Shift ID] ))" DataMember="Monthly Details" />
    <Item5 Ref="7" Name="calculatedField5" FieldType="Int16" DisplayName="Days of Month" Expression="(DateDiffDay([Month Start Date],[Month End Date] ))+1" DataMember="Monthly Details" />
    <Item6 Ref="8" Name="Dateofmonth" DisplayName="Date of Month" Expression="GetDate([Daily Attendance Date])" DataMember="Monthly Details" />
