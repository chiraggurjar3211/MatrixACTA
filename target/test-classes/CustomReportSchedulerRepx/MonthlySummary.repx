<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="24.1.6.0" Ref="1" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v24.1, Version=24.1.6.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Name="Monthly_Summary" DisplayName="Monthly_Summary" Margins="38, 1, 20, 180" PaperKind="A4" PageWidth="827" PageHeight="1169" Version="24.1" DataMember="Monthly Summary" DataSource="#Ref-0" Font="Courier New, 11pt" Tag_type="System.Byte" Tag="2">
  <Extensions>
    <Item1 Ref="2" Key="DataSerializationExtension" Value="CustomUntypedDataSetSerializer" />
  </Extensions>
  <CalculatedFields>
    <Item1 Ref="3" Name="monthname" FieldType="String" DisplayName="Month-Name" Expression=" Iif( [Month] == 1,'January', Iif( [Month] == 2,'February', Iif( [Month] ==3, 'March', Iif( [Month] ==4 , 'April' , Iif( [Month] == 5,'May' , Iif( [Month] == 6,'June' , Iif( [Month] == 7,'July' , Iif( [Month] == 8,'August' , Iif( [Month] == 9,'September' , Iif( [Month] == 10,'October' , Iif( [Month] == 11,'November' , Iif( [Month] == 12,'December' ,None )  )  )  )  )  )  )  )  )  )  ) ) " DataMember="Monthly Summary" />
    <Item2 Ref="4" Name="calculatedField1" FieldType="Int16" DisplayName="Net OT1 Hours" Expression="Floor([Net OT1-Mins] / 60) " DataMember="Monthly Summary" />
    <Item3 Ref="5" Name="calculatedfield3" FieldType="Int16" DisplayName="Net OT2 Hours" Expression="Floor([Net OT2-Mins] / 60) " DataMember="Monthly Summary" />
    <Item4 Ref="6" Name="calculatedField2" FieldType="Int16" DisplayName="Net OT3 Hours" Expression="Floor([Net OT3-Mins] / 60) " DataMember="Monthly Summary" />
    <Item5 Ref="7" Name="calculatedField3" FieldType="Int16" DisplayName="Net OT4 Hours" Expression="Floor([Net OT4-Mins] / 60) " DataMember="Monthly Summary" />
    <Item6 Ref="8" Name="calculatedField4" FieldType="Int16" DisplayName="Net OT5 Hours" Expression="Floor([Net OT5-Mins] / 60) " DataMember="Monthly Summary" />
    <Item7 Ref="9" Name="calculatedField6" FieldType="Int16" DisplayName="Payable (INR)" Expression=" ( [calculatedField1] * 50) +  ( [calculatedfield3] * 100) +  ( [calculatedField2] * 200) +  ( [calculatedField3] * 500) +  ( [calculatedField4] * 1000)  " DataMember="Monthly Summary" />
    <Item8 Ref="10" Name="calculatedField5" FieldType="Int16" DisplayName="Payable_Total" Expression="Sum( [calculatedField6] ) " DataMember="Monthly Summary" />
    <Item9 Ref="11" Name="OTNetworkPercent" FieldType="Float" DisplayName="Net OT(% of Work Hours)" Expression="([Net OT-Mins]/([Net Work Dur-Mins]+ ([Manual Cr OT-Mins] - [Manual Db OT-Mins])))*100" DataMember="Monthly Summary" />
  </CalculatedFields>
