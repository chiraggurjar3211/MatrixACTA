  <CalculatedFields>
    <Item1 Ref="3" Name="Punchtime" DisplayName="Event Time(HH:MM)" Expression=" Concat( [calculatedField4] ,':', [calculatedField3] )" DataMember="Events" />
    <Item2 Ref="4" Name="PUNCHDATE" DisplayName="Event Date" Expression=" GetDate( [Event Date Time] ) " DataMember="Events" />
    <Item3 Ref="5" Name="eventdelay" DisplayName="Event Delay_Duration(HH:MM)" Expression=" Concat( [zeropaddinghrs]  ,':', [zeropaddingeventdelay]  ) " DataMember="Events" />
    <Item4 Ref="6" Name="eventtype" DisplayName="Event Type : Entry/Exit" Expression=" Iif( [In/Out Event] == '0','IN' ,'OUT' ) " DataMember="Events" />
    <Item5 Ref="7" Name="zeropaddingeventdelay" DisplayName="Event Delay Duration(Mins)_Zero Padding" Expression=" Iif( Len( [eventsdelaymins] ) &lt; '2' , PadLeft( [eventsdelaymins] ,2 , '0') , [eventsdelaymins]  ) " DataMember="Events" />
    <Item6 Ref="8" Name="eventsdelaymins" FieldType="String" DisplayName="Event Delay Duration_Mins" Expression=" [Event Delay-Mins] % 60" DataMember="Events" />
    <Item7 Ref="9" Name="punchdelayhrs" DisplayName="Event Delay Duration_Hrs" Expression=" [Event Delay-Mins] /  60" DataMember="Events" />
    <Item8 Ref="10" Name="zeropaddinghrs" DisplayName="Event Delay Duration(Hours)_Zero Padding" Expression=" Iif( Len( [punchdelayhrs]  ) &lt; '2' , PadLeft( [punchdelayhrs]  ,2 , '0') , [punchdelayhrs]  ) " DataMember="Events" />
