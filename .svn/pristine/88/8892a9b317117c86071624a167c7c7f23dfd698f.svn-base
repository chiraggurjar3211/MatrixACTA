    <Item10 Ref="12" Name="calculatedField2" DisplayName="Event Time_Minute" Expression=" GetMinute( [Event Date Time] ) " DataMember="Events" />
    <Item11 Ref="13" Name="calculatedField3" DisplayName="Event Time(MInutes)_ZeroPadding" Expression=" Iif( Len( [calculatedField2]  ) &lt; '2' , PadLeft( [calculatedField2]  ,2 , '0') , [calculatedField2]   ) " DataMember="Events" />
    <Item12 Ref="14" Name="calculatedField4" DisplayName="Event Time(Hours)_Zero Padding" Expression=" Iif( Len( [calculatedField1]  ) &lt; '2' , PadLeft( [calculatedField1]  ,2 , '0') , [calculatedField1]   ) " DataMember="Events" />
    <Item13 Ref="15" Name="calculatedField6" DisplayName="Event Source Data" Expression="Iif([Event Source ID]==0,Iif([Device Name] != 'NULL',Concat('Device:',[Device Name] ),Concat('MID:',[Master Controller ID],' ','DID:',[Door ID] ) ) ,Iif([GPS Latitude] != 'NULL' &amp;&amp; [GPS Longitude] != 'NULL',Concat('GPSLat:',[GPS Latitude],' ','GPSLong:', [GPS Longitude]) ,Iif([GSM Latitude] != 'NULL' &amp;&amp; [GSM Longitude] != 'NULL',Concat('GSMLat:',[GSM Latitude],' ','GSMLong:',[GSM Longitude] ) ,Iif([MAC Address] != 'NULL',Concat('MAC:',[MAC Address]) ,Concat('BLE:',[BLE Code]) ) ) ) )" DataMember="Events" />
